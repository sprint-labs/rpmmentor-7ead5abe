# Copy to `.env` and fill in from the Supabase project you want to run against.
# `.env` is gitignored — never commit real project refs or keys.
#
# Which project to point at:
#   Local dev / feature work -> RPM Mentor Hub — Staging (emyxyqqftwnjpcmctkpe)
#   Production               -> RPM Mentor Hub (zdxxezquhvpjmoxlecjp), set in Vercel only
#
# Values live in Supabase Dashboard > Project Settings > API.
# The publishable (anon) key is safe in the browser; the service_role key is not
# and must never appear in this file or any VITE_-prefixed variable.

SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# VITE_-prefixed copies are inlined into the client bundle at build time.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
